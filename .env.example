# Supabase Postgres connection string (session pooler). Never commit the real value.
DATABASE_URL=

# Firebase Admin credential for verifying ID tokens. Provide ONE of:
#  - FIREBASE_SERVICE_ACCOUNT_JSON: the service-account JSON as a string (used on Render)
#  - GOOGLE_APPLICATION_CREDENTIALS: path to the service-account JSON file (used locally)
# Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Study planner (Jeene Mode). Optional: with no key, or with the flag off, plans come
# from the deterministic planner and nothing is sent anywhere. Never commit the value.
OPENAI_API_KEY=
# The planner model id. Must support strict structured outputs.
JEENE_PLANNER_MODEL=
# Kill switch. Ships false: the feature works fully without a provider.
JEENE_PLANNER_ENABLED=false

# Signs the short-lived links the app uses to open the chapter-notes viewer.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Not optional in a deployment. Left unset, every worker signs with its own random
# secret, so a link minted by one is refused by another and the notes fail to open
# intermittently — the worst way for anything to fail.
JEENE_ASSET_SECRET=
# Hosts the notes viewer may stream a PDF from, comma-separated.
#
# Leave empty in production: the default rule is https plus a globally-routable address,
# which is stricter than any list and does not go stale when storage moves. Naming hosts
# is for a local setup pointing at a plain-http fixture server.
JEENE_NOTES_STORAGE_HOSTS=

# --- Billing (Google Play and the App Store) --------------------------------
# One switch for selling *and* locking: left false, every store route answers 503 and
# every gate passes, so nobody meets a lock with no way through it.
JEENE_BILLING_ENABLED=false
# What the reconciler cron presents to /internal/billing/reconcile. Any long random
# string; the same value goes on the cron service. Unset, that endpoint answers 503
# rather than running unauthenticated — it can grant access.
JEENE_RECONCILE_SECRET=

# Google Play. The service account is the one Play Console lets view financial data and
# manage orders; paste its whole JSON key. Never commit it: it can refund and consume
# purchases. The push pair is the service account and audience chosen on the Pub/Sub push
# subscription, and is the only authentication the notifications route has.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_PUSH_AUDIENCE=

# The App Store. The bundle id alone verifies test-environment purchases; production
# ones also need the app's numeric Apple ID. The In-App Purchase key (key id, issuer id
# and the whole .p8 file, BEGIN/END lines included) lets the reconciler read
# notifications Apple could not deliver; purchases verify without it.
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Local development only: accept Xcode's StoreKit-testing transactions, which are signed
# by a certificate Apple never issued. Never set it on a deployment.
APPLE_ACCEPT_XCODE_TRANSACTIONS=false
